<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:MageSuite_Changelog:etc/changelog.xsd">
    <module id="MageSuite_GuestWishlist" name="MageSuite_GuestWishlist">
        <changelog>
            <tag version="1.2.1" date="2022-12-13">
                <entry>
                    <type>FIX</type>
                    <overview>Fix for doubled products when I merge guest and logged in user's Wishlist</overview>
                    <ticket_id>MGS-4122</ticket_id>
                </entry>
            </tag>
            <tag version="1.2.3" date="2022-12-13">
                <entry>
                    <type>FIX</type>
                    <overview>Fix for bug leaving products in wishlist after customer logs out</overview>
                    <ticket_id>MGS-4122</ticket_id>
                </entry>
            </tag>
            <tag version="1.2.5" date="2023-08-18">
                <entry>
                    <type>FIX</type>
                    <overview>Fix for bug leaving products in wishlist after customer logs out</overview>
                    <ticket_id>KRA-492</ticket_id>
                </entry>
            </tag>
            <tag version="1.2.6" date="2026-06-26">
                <entry>
                    <type>FIX</type>
                    <overview>Allow guests to update an existing wishlist item</overview>
                    <description>
                        SkipSaveIfItemExists no longer treats the item being saved as its own duplicate,
                        so updating the quantity (or options) of an existing wishlist item is persisted
                        instead of being silently skipped.
                    </description>
                </entry>
            </tag>
        </changelog>
    </module>
</config>
